[Unit]
Description=Rift Minecraft session proxy
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=rift
Group=rift
WorkingDirectory=/etc/rift
# Set rift.config.instance_database = "/var/lib/rift/rift.sqlite3" in rift.lua.
# Persistent, owned by rift, and writable even with ProtectSystem=strict.
StateDirectory=rift
StateDirectoryMode=0700
# Optional, root-readable file containing RIFT_ADMIN_TOKEN=... when admin is enabled.
EnvironmentFile=-/etc/rift/admin.env
ExecStartPre=/usr/local/bin/rift check /etc/rift/rift.lua
ExecStart=/usr/local/bin/rift --config /etc/rift/rift.lua
ExecReload=/usr/local/bin/rift check /etc/rift/rift.lua
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# The systemd default, stated because managed servers depend on it: stopping or
# restarting the unit also kills server processes left by a killed Rift.
KillMode=control-group
# Must exceed shutdown_timeout_ms (30 seconds by default).
TimeoutStopSec=40s
Restart=on-failure
RestartSec=5s
# Two sockets per relay, plus listeners, metrics and runtime overhead.
LimitNOFILE=8192
# Lets Rift put each managed server with a memory_limit into its own cgroup
# below this unit. DelegateSubgroup needs systemd 254; older versions ignore
# it and Rift moves itself into the same subgroup.
Delegate=memory
DelegateSubgroup=rift
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true
# Left out on purpose: MemoryDenyWriteExecute (LuaJIT and the JVM generate
# code), ProtectKernelTunables and ProtectControlGroups (both make the
# delegated cgroup read-only), and a SystemCallFilter (managed servers are
# arbitrary JVMs and Landlock needs its own system calls).

[Install]
WantedBy=multi-user.target
